# ============================================================================
#  Fardeen — Environment Template
#  Copy to `.env` (git-ignored) and set real secrets:  cp .env.example .env
#
#  docker-compose reads .env for ${VAR} interpolation. Per-service wiring that is NOT a
#  secret (each service's DATABASE_URL, TCP_PORT, READY_CHECK_* flags, the gateway host:port
#  map) lives directly in the compose files. This file holds the shared secrets/config those
#  files interpolate, plus keys consumed by services in later phases.
#
#  Values here must NOT contain inline (trailing) comments — compose would treat them as part
#  of the value.
# ============================================================================

# ---- Global ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- Postgres (shared instance; per-service logical DBs created by infra/postgres/init) ----
POSTGRES_USER=fardeen
POSTGRES_PASSWORD=fardeen_dev_pw
POSTGRES_DB=fardeen

# ---- Redis ----
REDIS_PASSWORD=

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=fardeen
MINIO_ROOT_PASSWORD=fardeen_dev_pw
MINIO_BUCKET=fardeen-media

# ---- Gateway / Frontend (public) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# ---- Notifications (email transport — wired in Phase 4) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Ansari Space Craft <no-reply@fardeen.example>
SALES_INBOX=sales@fardeen.example

# ============================================================================
#  Reference — internal wiring already encoded in the compose files
#  (documented here; you normally do not need to set these).
# ============================================================================
#
#  Health/transport ports (per Nest container):
#    HTTP_PORT=3001            # liveness/readiness HTTP server (Docker healthcheck target)
#    TCP_PORT=4010..4018       # NestJS microservice transport (gateway connects here)
#  Gateway: GATEWAY_PORT=4000, GATEWAY_GLOBAL_PREFIX=api/v1  (health at /api/v1/health)
#  Frontend: PORT=3000 (health at /api/health)
#
#  Readiness dependency probes (set per service in compose):
#    READY_CHECK_POSTGRES / READY_CHECK_REDIS / READY_CHECK_MINIO = true|false
#    admin-service has NONE of the postgres checks (it owns no database).
#
#  Per-service DATABASE_URL (its own logical DB), e.g.:
#    postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/auth_db?schema=public
#    databases: auth_db cms_db project_db service_db contact_db quotation_db media_db notification_db
#
#  Hot reload (Windows/WSL2): CHOKIDAR_USEPOLLING=true, WATCHPACK_POLLING=true (set in dev compose).

# ============================================================================
#  Auth (JWT RS256) — consumed in Phase 4. In prod, mount PEMs as read-only secrets.
# ============================================================================
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
JWT_ISSUER=fardeen-auth
JWT_AUDIENCE=fardeen-api
REFRESH_COOKIE_NAME=fardeen_rt
REFRESH_COOKIE_DOMAIN=localhost
