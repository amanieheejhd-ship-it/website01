{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend/src",
  "projectType": "application",
  "tags": [
    "type:app-frontend"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/apps/frontend/.next"],
      "options": {
        "command": "next build",
        "cwd": "apps/frontend",
        "env": { "NODE_ENV": "production" }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.json --noEmit"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev -H 0.0.0.0 -p 3000",
        "cwd": "apps/frontend"
      }
    }
  }
}
